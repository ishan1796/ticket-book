PORT=4000
NODE_ENV=production

# Database & Redis Infrastructure
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ticket_booking?schema=public"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Cryptographic & Signing Secrets
JWT_ACCESS_SECRET="production_super_secret_jwt_access_key_min_32_chars"
JWT_REFRESH_SECRET="production_super_secret_jwt_refresh_key_min_32_chars"
QR_SIGNING_SECRET="production_super_secret_qr_token_key_min_32_chars"

# Real Transactional Email Provider (Resend / SendGrid / Postmark)
RESEND_API_KEY="re_123456789_example_key"
EMAIL_FROM="TicketBook Notifications <tickets@ticketbook.com>"

# Security & CORS
CORS_ORIGIN="http://localhost:3000"
